# ========================================================
# TRIGGERABLE RADIO — Yapılandırma Ayarları (.env)
# ========================================================

# Docker Hub imaj sürümü (latest veya 1.0 gibi sabit bir sürüm)
IMAGE_TAG=latest

# Sunucu Portu (Varsayılan: 8836)
PORT=8836

# Bağlanılacak Bluetooth Hoparlörün MAC Adresi
BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF

# Bluetooth bağlantısı koptuğunda yeniden deneme aralığı (saniye)
BT_RECONNECT_INTERVAL=5

# Konteyner başladığında hoparlöre otomatik bağlanma (true / false)
AUTO_CONNECT_BT=true

# Bluetooth hoparlör koptuktan sonra tekrar bağlandığında radyo yayınına kaldığı yerden devam etme
AUTO_RESUME_ON_BT=true

# Çalınacak Radyo Yayını URL'si
# Varsayılan: https://radyoilef.ankara.edu.tr/live (Doğrudan MP3 canlı yayın akışı)
# Alternatif: https://radyoilef.ankara.edu.tr/dinle.m3u (M3U çalma listesi)
STREAM_URL=https://radyoilef.ankara.edu.tr/live

# Konteyner başlar başlamaz radyo çalsın mı? (true / false)
AUTO_START_RADIO=false

# Ses çıkış motoru (pulse)
AUDIO_OUTPUT=pulse

# Hoparlörün açılıştaki ses seviyesi (yüzde 0-100, varsayılan: 30). Sonrasında hoparlörün düğmeleriyle ayarlanabilir
DEFAULT_VOLUME=30


# Host'ta PipeWire ses sunucusunu çalıştıran kullanıcının UID'si (id -u ile öğrenilir)
HOST_UID=1000
